# Copy to .env.local and fill in.

# ---- Vercel + local ----
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The only email allowed to sign in to /admin
ALLOWED_EMAIL=
# GitHub fine-grained token (this repo only, Actions: read & write) so /admin can start a scrape
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Gakumat/beyblade-x-workshop

# ---- Local + GitHub Actions secrets only (NEVER add to Vercel) ----
# Supabase → Project Settings → API → service_role (secret). Used by the scraper.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# The database password you set when creating the project
SUPABASE_DB_PASSWORD=
# The project ref (the subdomain of the project URL)
SUPABASE_PROJECT_REF=
